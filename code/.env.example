# ============================================================================
# QA Platform — catálogo de configuração (.env.example)
# ============================================================================
# Copie este arquivo para `.env` e ajuste os valores. O `.env` real NUNCA é
# versionado (veja `.gitignore`). Segredos aparecem aqui apenas como MARCADORES
# (ex.: CHANGE_ME) — nunca coloque valores reais neste arquivo de exemplo.
#
# Fonte de verdade: cada valor é resolvido pelo Config_Resolver/SecretResolver
# no pipe env -> AWS Secrets Manager, com falha rápida para as obrigatórias.
# Convenção de toggles: "true"/"false" (case-insensitive); default = false.
# ----------------------------------------------------------------------------

# === Obrigatória ===========================================================

# SERVICE_VERSION (OBRIGATÓRIA) — versão do serviço exposta no campo `version`
# da resposta de /health. Sem ela, o serviço falha rápido na inicialização.
SERVICE_VERSION=0.1.0

# === Modelo / IA ===========================================================

# MODEL_PROVIDER (obrigatória quando a camada de IA inicializa) — identifica o
# provider de modelo. Não há default fixado no código: se a camada de IA for
# inicializada sem esta variável, ela falha rápido nomeando-a.
# Exemplos: stub, bedrock, ollama.
MODEL_PROVIDER=stub

# === Observabilidade / logging =============================================

# LOG_LEVEL (opcional, default INFO) — nível do logging estruturado JSON.
# Valores usuais: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# ENVIRONMENT (opcional, default local) — rótulo do ambiente (local/dev/prod).
ENVIRONMENT=local

# TRACING_ENABLED (opcional, default false) — liga o tracing OpenTelemetry.
# No-op quando false. Também é ligado implicitamente se OTEL_EXPORTER_OTLP_ENDPOINT
# estiver definido.
TRACING_ENABLED=false

# OTEL_EXPORTER_OTLP_ENDPOINT (opcional, default vazio) — endpoint OTLP do
# coletor de traces. Quando presente, também liga o tracing.
# Exemplo local: http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# === AWS / Secrets Manager (LocalStack em dev) =============================

# AWS_ENDPOINT_URL (opcional, default vazio) — endpoint da AWS. Quando presente,
# liga o AWSSecretsManagerProvider (aponta para o LocalStack em desenvolvimento).
# Deixe vazio para não consultar o Secrets Manager (usa só variáveis de ambiente).
AWS_ENDPOINT_URL=http://localhost:4566

# LOCALSTACK_PORT (opcional, default 4566) — porta do LocalStack publicada no
# host (usada pelo docker-compose).
LOCALSTACK_PORT=4566

# SECRET_NAME (opcional, default qa-platform-secrets) — nome lógico do segredo
# JSON no AWS Secrets Manager de onde as chaves são resolvidas.
SECRET_NAME=qa-platform-secrets

# === Persistência de run state (Run State Store) ===========================

# RUN_STORE_BACKEND (opcional, default in_memory) — seleciona o adapter de
# persistência do estado das runs. Valores: in_memory | dynamodb.
#   - in_memory: armazenamento efêmero em memória (default; ideal para dev/testes).
#   - dynamodb : armazenamento durável no DynamoDB (exige RUN_TABLE_NAME).
RUN_STORE_BACKEND=in_memory

# RUN_TABLE_NAME (obrigatória quando RUN_STORE_BACKEND=dynamodb) — nome da tabela
# DynamoDB usada pelo adapter durável. Sem ela, a factory falha rápido nomeando o
# parâmetro (não cai no backend in_memory). Ignorada quando backend=in_memory.
# RUN_TABLE_NAME=qa-platform-run-state

# Nota: com RUN_STORE_BACKEND=dynamodb, o cliente DynamoDB reusa AWS_ENDPOINT_URL
# (LocalStack em dev — ver seção AWS acima) e AWS_REGION (região do cliente) do
# bootstrap existente; não há variáveis dedicadas para essas duas configurações.
# AWS_REGION=us-east-1

# === Segurança de borda ====================================================

# CORS_ALLOWED_ORIGINS (opcional, default vazio) — origens CORS permitidas em
# CSV (sem "*"). Vazio = nenhuma origem cross-site.
# Exemplo: https://app.exemplo.com,https://admin.exemplo.com
CORS_ALLOWED_ORIGINS=

# ALLOWED_HOSTS (opcional, default *) — hosts confiáveis (CSV) para o
# TrustedHostMiddleware. Em produção, restrinja aos hosts reais.
# Exemplo: api.exemplo.com,exemplo.com
ALLOWED_HOSTS=*

# HTTPS_REDIRECT_ENABLED (opcional, default false) — liga o redirect HTTP->HTTPS.
# Em geral o TLS termina no API Gateway; mantenha false localmente.
HTTPS_REDIRECT_ENABLED=false

# RATE_LIMIT_ENABLED (opcional, default false) — liga o rate limit por
# principal/IP (stub).
RATE_LIMIT_ENABLED=false

# AUTH_ENABLED (opcional, default false) — liga a autenticação por request
# (stub seguro: nega até o JWT estar configurado; nunca "aprova tudo").
AUTH_ENABLED=false

# === Servidor local (CLI `serve` via uvicorn) =============================

# HOST (opcional, default 0.0.0.0) — endereço de bind do servidor local.
HOST=0.0.0.0

# PORT (opcional, default 8000) — porta do servidor local.
PORT=8000

# === Segredos (MARCADORES — nunca valores reais) ===========================
# Quando um segredo for necessário, ele é resolvido do Secrets Manager (JSON em
# SECRET_NAME) ou, em dev, da env correspondente. Represente-o SEMPRE por um
# marcador neste arquivo de exemplo — nunca cole um valor real aqui nem no `.env`
# versionado.
#
# Exemplo (descomente e defina no `.env` local, nunca aqui):
# SOME_API_KEY=CHANGE_ME
# CONFIDENT_API_KEY=CHANGE_ME
